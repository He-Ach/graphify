<Window x:Class="SampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SampleApp.Controls"
        xmlns:views="clr-namespace:SampleApp.Views"
        Title="Sample App" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="searchBox"
                 Grid.Row="0"
                 TextChanged="searchBox_TextChanged"
                 KeyDown="searchBox_KeyDown"
                 Margin="8"/>

        <Button x:Name="submitButton"
                Grid.Row="0"
                Content="Submit"
                Click="submitButton_Click"
                Margin="8"/>

        <ListBox x:Name="resultsList"
                 Grid.Row="1"
                 SelectionChanged="resultsList_SelectionChanged"
                 Margin="8"/>

        <local:SearchPanel x:Name="searchPanel"
                           Grid.Row="1"
                           Loaded="searchPanel_Loaded"/>

        <views:DetailView x:Name="detailView"
                          Grid.Row="1"/>
    </Grid>
</Window>
